rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /results/{resultId} {
      // Any logged-in user can submit their own result
      allow create: if request.auth != null
                     && request.resource.data.studentEmail == request.auth.token.email;

      // Only the teacher account can read all results
      allow read: if request.auth != null
                  && request.auth.token.email == "anass.khadir@usmba.ac.ma";

      // No one can update or delete results
      allow update, delete: if false;
    }
  }
}
